# ============================================================================
# IPL 2026 Match Prediction Platform — Environment Configuration (.env.example)
# Copy this file to .env for local development or configure in Render/Vercel
# ============================================================================

# --- Backend (FastAPI + SQLAlchemy) ---
ENVIRONMENT=development
DEBUG=false

# Local Dev (SQLite default if omitted):
DATABASE_URL=sqlite:///./backend/ipl_predictions.db

# Production PostgreSQL (Neon / Supabase / Render / Railway):
# DATABASE_URL=postgresql://user:password@ep-cool-stadium-123456.us-east-2.aws.neon.tech/ipl_predictions?sslmode=require

# CORS & Rate Limiting
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://ipl-2026-predictor.vercel.app
RATE_LIMIT_PREDICT=60/minute
CACHE_TTL_SECONDS=300

# Optional custom paths (auto-resolved relative to project root by default)
# MODEL_ARTIFACT_PATH=ml/artifacts/ipl_model_v1.joblib
# DATASET_PATH=IPL.csv

# --- Frontend (Next.js App Router) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
